# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Password for the PostgreSQL voxr user
POSTGRES_PASSWORD=

# LiveKit credentials — must match between the backend and LiveKit service
# Generate random values, e.g.: openssl rand -hex 16
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public hostname clients use to reach the backend (no protocol or port)
PHX_HOST=localhost

# Public WebSocket URL for LiveKit — Electron clients connect here directly
# Must be reachable from client machines, not just the server
LIVEKIT_URL=ws://localhost:7880
